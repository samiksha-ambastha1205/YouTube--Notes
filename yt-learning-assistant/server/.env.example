OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: pin one specific free model to be tried FIRST. Leave unset and
# the app will start with "openrouter/free" (auto-picks a free model) plus
# a few other free models as backups - see FALLBACK_MODELS in src/ai.ts.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

PORT=3000
